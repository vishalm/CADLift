# ====================================
# CADLift Backend Configuration
# ====================================
# Copy this file to .env and update values for your environment

# ============ APPLICATION ============
APP_NAME=CADLift Backend
ENVIRONMENT=development
# Options: development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# ============ DATABASE ============
# SQLite for development
DATABASE_URL=sqlite+aiosqlite:///./cadlift.db
# PostgreSQL for production (uncomment and configure):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/cadlift

# ============ SECURITY ============
# IMPORTANT: Change this in production!
JWT_SECRET_KEY=change-me-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ============ CORS CONFIGURATION ============
# For development, allow all origins
CORS_ORIGINS=*
# For production, specify allowed domains (comma-separated):
# CORS_ORIGINS=https://cadlift.com,https://app.cadlift.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
CORS_ALLOW_HEADERS=Authorization,Content-Type,X-Request-ID

# ============ STORAGE ============
STORAGE_PATH=./storage

# ============ TASK QUEUE ============
# Set to true to use Celery with Redis for async processing
ENABLE_TASK_QUEUE=false
REDIS_URL=redis://localhost:6379/0

# ============ FILE LIMITS ============
MAX_UPLOAD_MB=25

# ============ LLM INTEGRATION (Azure OpenAI) ============
# Options: none, azure
LLM_PROVIDER=none
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Deployment names as created in Azure AI Foundry
AZURE_DEPLOYMENT_NAME=gpt-5-mini
# Optional: separate deployment for blueprint/image analysis (defaults to AZURE_DEPLOYMENT_NAME)
AZURE_VISION_DEPLOYMENT_NAME=
# Optional: image deployment (e.g. gpt-image-1); enables text-to-image for AI meshes and render studio photos
AZURE_IMAGE_DEPLOYMENT_NAME=
LLM_TIMEOUT_SECONDS=60.0

# ============ RENDER STUDIO ============
# Photoreal images, orbit videos and construction timelapses of the 3D view.
# Photos and videos each use Azure OpenAI when its deployment is set, otherwise FAL.
# Photos: AZURE_IMAGE_DEPLOYMENT_NAME above (gpt-image-1). Videos: Sora 2 deployment below.
AZURE_VIDEO_DEPLOYMENT_NAME=
# FAL (image-blaster's provider), used when the Azure deployment for that step is empty.
# Get a key at https://fal.ai
FAL_KEY=
FAL_IMAGE_ENDPOINT=fal-ai/nano-banana-2/edit
FAL_VIDEO_ENDPOINT=fal-ai/kling-video/v2.5-turbo/pro/image-to-video
# From a finished render photo (render studio cards), via FAL:
#   3D objects (Hunyuan 3D) and ambient sound (ElevenLabs)
FAL_3D_ENDPOINT=fal-ai/hunyuan3d-v3/image-to-3d
FAL_SFX_ENDPOINT=fal-ai/elevenlabs/sound-effects/v2
# Explorable 3D worlds (Gaussian splats) from a render photo. Key: https://platform.worldlabs.ai
WORLD_LABS_API_KEY=
WORLD_LABS_MODEL=marble-1.1
# auto (Azure first, then FAL), azure, or fal
RENDER_PROVIDER=auto
RENDER_TIMEOUT_SECONDS=900

# ============ VISION API ============
VISION_API_URL=
VISION_API_KEY=
VISION_TIMEOUT_SECONDS=30.0

# ============ STABLE DIFFUSION (LOCAL) ============
ENABLE_STABLE_DIFFUSION=false
STABLE_DIFFUSION_MODEL=runwayml/stable-diffusion-v1-5
# Leave empty for auto-detection (cuda if available, else cpu)
STABLE_DIFFUSION_DEVICE=
STABLE_DIFFUSION_HEIGHT=640
STABLE_DIFFUSION_WIDTH=640
STABLE_DIFFUSION_STEPS=30
STABLE_DIFFUSION_GUIDANCE=7.5
